# Modello delle variabili d'ambiente di Sedette.
# Copialo in .env e compila i valori: .env NON va mai versionato.
# Qui ci sono solo segnaposto.

# --- Sedette ------------------------------------------------------------------
# Prefisso SEDETTE_; "__" separa sezione e chiave di sedette.toml.

# Endpoint WebSocket di Polygon PoS mainnet (chain id 137). Contiene la chiave
# del provider: tienilo solo qui. Per provare senza account esiste l'endpoint
# pubblico wss://polygon-bor-rpc.publicnode.com, senza chiave ma con limiti di
# frequenza: va bene per seguire i nuovi blocchi, non per il backfill.
SEDETTE_RPC__WS_URL=wss://polygon-mainnet.example.com/ws/<chiave>

# Endpoint HTTP, facoltativo in Fase 0.
# SEDETTE_RPC__HTTP_URL=https://polygon-mainnet.example.com/<chiave>

# Override facoltativi di sedette.toml:
# SEDETTE_LOGGING__FORMAT=json
# SEDETTE_LOGGING__FILTER=info,sedette_chain=debug
